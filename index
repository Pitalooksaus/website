  if (!data) return;
  const blob = new Blob([data.title + '\n' + '='.repeat(data.title.length) + '\n\n' + data.content + '\n\n---\nExam Reader – June 2026 · 5 D/A · Óscar Romero College'], {type: 'text/plain;charset=utf-8'});
