function toggleVocab(btn) {
  const panel = btn.nextElementSibling;
  const isOpen = panel.classList.toggle('open');
  btn.textContent = (isOpen ? '▼ Hide key vocabulary' : '▶ Show key vocabulary') + btn.textContent.replace(/[▼▶] (Hide|Show) key vocabulary/, '').trim().replace(/^\s*\(/, ' (');
  if (!btn.textContent.includes('(')) {
    const match = btn.getAttribute('onclick');
  }
  btn.textContent = isOpen
    ? btn.textContent.replace('▶ Show', '▼ Hide')
    : btn.textContent.replace('▼ Hide', '▶ Show');
}
