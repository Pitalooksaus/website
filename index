<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Exam Reader – June 2026 5 D/A · Study Summaries</title>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600;700&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet">
<style>
  :root {
    --ink: #1a1815;
    --paper: #faf8f4;
    --cream: #f0ece2;
    --rule: #d4cfc4;
    --accent: #c84b2f;
    --accent2: #2f6b8f;
    --accent3: #4a7c3f;
    --accent4: #7a4fc4;
    --accent5: #b87a1a;
    --muted: #6b6560;
    --tag-bg: #e8e2d6;
  }

  * { box-sizing: border-box; margin: 0; padding: 0; }

  body {
    font-family: 'DM Sans', sans-serif;
    background: var(--paper);
    color: var(--ink);
    min-height: 100vh;
  }

  /* ── MASTHEAD ── */
  .masthead {
    border-bottom: 3px double var(--ink);
    padding: 2.5rem 3rem 1.5rem;
    position: relative;
    overflow: hidden;
  }
  .masthead::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 4px;
    background: repeating-linear-gradient(90deg, var(--accent) 0, var(--accent) 40px, var(--paper) 40px, var(--paper) 44px);
  }
  .masthead-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    flex-wrap: wrap;
    gap: 1rem;
  }
  .masthead h1 {
    font-family: 'Playfair Display', serif;
    font-size: clamp(1.8rem, 4vw, 3rem);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.02em;
  }
  .masthead h1 span { color: var(--accent); }
  .masthead-meta {
    font-size: 0.78rem;
    color: var(--muted);
    text-align: right;
    border-left: 2px solid var(--rule);
    padding-left: 1rem;
    line-height: 1.8;
  }
  .masthead-sub {
    margin-top: 0.75rem;
    font-size: 0.85rem;
    color: var(--muted);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    border-top: 1px solid var(--rule);
    padding-top: 0.75rem;
    display: flex;
    gap: 2rem;
    flex-wrap: wrap;
  }
  .masthead-sub a {
    color: var(--accent2);
    text-decoration: none;
    font-weight: 500;
    transition: color .2s;
  }
  .masthead-sub a:hover { color: var(--accent); }

  /* ── DOWNLOAD ALL ── */
  .download-all-bar {
    background: var(--ink);
    color: var(--paper);
    padding: 0.9rem 3rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .download-all-bar p { font-size: 0.85rem; opacity: 0.75; }
  .btn-download-all {
    background: var(--accent);
    color: white;
    border: none;
    padding: 0.55rem 1.4rem;
    border-radius: 2px;
    font-family: 'DM Sans', sans-serif;
    font-size: 0.82rem;
    font-weight: 500;
    cursor: pointer;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    transition: background .2s, transform .1s;
  }
  .btn-download-all:hover { background: #a83a20; }
  .btn-download-all:active { transform: scale(0.97); }

  /* ── GRID ── */
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
    gap: 0;
    border-top: 1px solid var(--rule);
  }

  /* ── CARD ── */
  .card {
    border-right: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
    padding: 2rem 2rem 1.5rem;
    position: relative;
    transition: background .2s;
    display: flex;
    flex-direction: column;
  }
  .card:hover { background: var(--cream); }

  .card-number {
    font-family: 'Playfair Display', serif;
    font-size: 3.5rem;
    font-weight: 700;
    color: var(--rule);
    line-height: 1;
    margin-bottom: 0.5rem;
    letter-spacing: -0.04em;
  }

  .card-accent-bar {
    height: 3px;
    width: 40px;
    margin-bottom: 1rem;
    border-radius: 1px;
  }

  .card-title {
    font-family: 'Playfair Display', serif;
    font-size: 1.15rem;
    font-weight: 600;
    line-height: 1.3;
    margin-bottom: 0.35rem;
  }

  .card-source {
    font-size: 0.72rem;
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.07em;
    margin-bottom: 1.2rem;
  }

  .card-summary {
    font-size: 0.88rem;
    line-height: 1.75;
    color: #3a3633;
    margin-bottom: 1.2rem;
    flex: 1;
  }

  .themes {
    display: flex;
    flex-wrap: wrap;
    gap: 5px;
    margin-bottom: 1.2rem;
  }
  .theme-tag {
    font-size: 0.68rem;
    padding: 3px 9px;
    background: var(--tag-bg);
    border-radius: 2px;
    color: var(--muted);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  /* vocab table */
  .vocab-toggle {
    font-size: 0.75rem;
    color: var(--accent2);
    background: none;
    border: none;
    cursor: pointer;
    padding: 0;
    font-family: 'DM Sans', sans-serif;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-decoration: underline;
    margin-bottom: 0.5rem;
    display: block;
  }
  .vocab-panel {
    display: none;
    border-top: 1px solid var(--rule);
    padding-top: 0.75rem;
    margin-bottom: 1rem;
  }
  .vocab-panel.open { display: block; }
  .vocab-entry {
    display: flex;
    gap: 0.5rem;
    font-size: 0.78rem;
    padding: 0.35rem 0;
    border-bottom: 1px dotted var(--rule);
    line-height: 1.4;
  }
  .vocab-word {
    font-weight: 500;
    color: var(--ink);
    min-width: 110px;
    flex-shrink: 0;
  }
  .vocab-def { color: var(--muted); }

  /* grammar box */
  .grammar-box {
    background: var(--cream);
    border-left: 3px solid var(--accent5);
    padding: 0.6rem 0.8rem;
    font-size: 0.78rem;
    color: #4a3c10;
    line-height: 1.5;
    margin-bottom: 1.2rem;
    display: none;
  }
  .grammar-box.show { display: block; }

  /* card footer */
  .card-footer {
    border-top: 1px solid var(--rule);
    padding-top: 0.9rem;
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }
  .btn {
    font-family: 'DM Sans', sans-serif;
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    padding: 0.45rem 0.9rem;
    border-radius: 2px;
    cursor: pointer;
    transition: all .15s;
    border: 1px solid currentColor;
    background: transparent;
  }
  .btn-primary {
    color: white;
    border-color: transparent;
    background: var(--ink);
  }
  .btn-primary:hover { opacity: 0.8; }
  .btn-secondary { color: var(--muted); }
  .btn-secondary:hover { color: var(--ink); background: var(--tag-bg); }

  /* ── CONTEXT LABELS ── */
  .context-section {
    margin-bottom: 1rem;
  }
  .context-section h4 {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--muted);
    margin-bottom: 0.5rem;
  }
  .context-item {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 0.4rem;
    align-items: flex-start;
    font-size: 0.8rem;
    line-height: 1.5;
  }
  .ctx-label {
    font-size: 0.65rem;
    font-weight: 500;
    padding: 2px 7px;
    border-radius: 2px;
    white-space: nowrap;
    flex-shrink: 0;
    margin-top: 1px;
  }
  .ctx-thesis    { background: #fde8e4; color: #8c2a14; }
  .ctx-evidence  { background: #e4f0f9; color: #14507a; }
  .ctx-counter   { background: #f4eafb; color: #5a2880; }
  .ctx-concede   { background: #e9f7e9; color: #245a20; }
  .ctx-personal  { background: #fff4e0; color: #7a4500; }
  .ctx-conclude  { background: #e2e8f0; color: #2d3748; }
  .ctx-quote     { background: #fef9e0; color: #6b4e00; }

  /* ── FOOTER ── */
  .site-footer {
    border-top: 3px double var(--ink);
    padding: 1.5rem 3rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
    font-size: 0.78rem;
    color: var(--muted);
  }
  .site-footer strong { color: var(--ink); }

  /* print */
  @media print {
    .btn, .btn-download-all, .vocab-toggle, .download-all-bar, .masthead-sub { display: none !important; }
    .vocab-panel { display: block !important; }
    .grammar-box { display: block !important; }
    .card { break-inside: avoid; border: 1px solid #ccc; margin-bottom: 1rem; }
  }
</style>
</head>
